{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "essay.schema.json",
  "title": "Front matter of an original essay hypo (07-question-bank/essays/**/E-*.md)",
  "type": "object",
  "required": [
    "id",
    "type",
    "subjects",
    "coverage_ids",
    "rule_ids",
    "calls",
    "issues",
    "time_minutes",
    "source",
    "status",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E-([A-Z]{3}|XO)-\\d{3}$"
    },
    "type": {
      "enum": [
        "single",
        "crossover"
      ]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "BUS",
          "CIV",
          "CMP",
          "CON",
          "CTR",
          "CRM",
          "EVD",
          "PRF",
          "PRP",
          "REM",
          "TRT",
          "WIL",
          "TRS"
        ]
      }
    },
    "coverage_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,3}-(MBE|CBX|SUP|PAST)-[A-Za-z0-9.\\-]+$"
      },
      "minItems": 1
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[A-Z]{3}-\\d{3}$"
      },
      "minItems": 1
    },
    "calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "issues": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "issue",
          "points"
        ],
        "additionalProperties": false,
        "properties": {
          "issue": {
            "type": "string"
          },
          "points": {
            "type": "integer",
            "minimum": 1
          },
          "call": {
            "type": "integer",
            "minimum": 1
          },
          "coverage_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,3}-(MBE|CBX|SUP|PAST)-[A-Za-z0-9.\\-]+$"
            }
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R-[A-Z]{3}-\\d{3}$"
            }
          },
          "major": {
            "type": "boolean"
          }
        }
      }
    },
    "time_minutes": {
      "const": 60
    },
    "source": {
      "const": "original"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified"
      ]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pt.schema.json",
  "title": "Front matter of an original Performance Test exercise (07-question-bank/pt/PT-*.md)",
  "type": "object",
  "required": [
    "id",
    "title",
    "task_type",
    "area",
    "coverage_ids",
    "time_minutes",
    "source",
    "status",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PT-\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "task_type": {
      "enum": [
        "objective-memo",
        "persuasive-brief",
        "client-letter",
        "demand-letter",
        "drafting-will",
        "drafting-contract",
        "drafting-other",
        "closing-argument",
        "opening-statement",
        "discovery-plan",
        "other"
      ]
    },
    "area": {
      "type": "string"
    },
    "coverage_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,3}-(MBE|CBX|SUP|PAST)-[A-Za-z0-9.\\-]+$"
      },
      "minItems": 1
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[A-Z]{3}-\\d{3}$"
      }
    },
    "time_minutes": {
      "const": 90
    },
    "source": {
      "const": "original"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified"
      ]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

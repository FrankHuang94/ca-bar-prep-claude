{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcq.schema.json",
  "title": "Original MBE-style multiple-choice question",
  "type": "object",
  "required": [
    "id",
    "subject",
    "coverage_ids",
    "rule_ids",
    "difficulty",
    "stem",
    "call",
    "options",
    "answer",
    "explanation_correct",
    "explanation_each_wrong_option",
    "trap_type",
    "authority",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^Q-(CIV|CON|CTR|CRM|EVD|PRP|TRT)-\\d{4}$"
    },
    "subject": {
      "enum": [
        "CIV",
        "CON",
        "CTR",
        "CRM",
        "EVD",
        "PRP",
        "TRT"
      ]
    },
    "coverage_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,3}-(MBE|CBX|SUP|PAST)-[A-Za-z0-9.\\-]+$"
      },
      "minItems": 1
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[A-Z]{3}-\\d{3}$"
      },
      "minItems": 1
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "stem": {
      "type": "string",
      "minLength": 60
    },
    "call": {
      "type": "string",
      "minLength": 10
    },
    "options": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "string",
          "minLength": 1
        },
        "B": {
          "type": "string",
          "minLength": 1
        },
        "C": {
          "type": "string",
          "minLength": 1
        },
        "D": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answer": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "explanation_correct": {
      "type": "string",
      "minLength": 40
    },
    "explanation_each_wrong_option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "string",
          "minLength": 20
        },
        "B": {
          "type": "string",
          "minLength": 20
        },
        "C": {
          "type": "string",
          "minLength": 20
        },
        "D": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "trap_type": {
      "enum": [
        "confused-rule",
        "wrong-standard",
        "minority-rule",
        "missing-element",
        "right-result-wrong-reason",
        "true-but-irrelevant",
        "overbroad",
        "exception-trap",
        "procedural-posture",
        "fact-misread",
        "other"
      ]
    },
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "source": {
      "const": "original"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified"
      ]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-front-matter.schema.json",
  "title": "YAML front matter required on every Markdown content file in a numbered folder",
  "type": "object",
  "required": [
    "subject",
    "topic",
    "coverage_ids",
    "tested_on",
    "exam_frequency",
    "last_verified",
    "status"
  ],
  "properties": {
    "subject": {
      "enum": [
        "BUS",
        "CIV",
        "CMP",
        "CON",
        "CTR",
        "CRM",
        "EVD",
        "PRF",
        "PRP",
        "REM",
        "TRT",
        "WIL",
        "TRS",
        "exam-intel",
        "study-plan",
        "foundations",
        "performance-test",
        "mbe",
        "past-exams",
        "question-bank",
        "high-yield",
        "exam-strategy",
        "progress",
        "meta",
        "crossover"
      ],
      "description": "Subject code, or a meta value for non-subject files"
    },
    "topic": {
      "type": "string",
      "minLength": 3
    },
    "coverage_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,3}-(MBE|CBX|SUP|PAST)-[A-Za-z0-9.\\-]+$"
      }
    },
    "tested_on": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "MBE",
          "essay",
          "PT",
          "none"
        ]
      }
    },
    "exam_frequency": {
      "type": "object",
      "required": [
        "level",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "high",
            "med",
            "low",
            "n/a"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified"
      ]
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[A-Z]{3}-\\d{3}$"
      }
    }
  },
  "additionalProperties": true
}

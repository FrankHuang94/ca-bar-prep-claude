{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulation.schema.json",
  "title": "Manifest of an assembled full mock exam (07-question-bank/simulations/SIM-##.yaml)",
  "type": "object",
  "required": [
    "id",
    "created",
    "essays",
    "pt",
    "mbe"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SIM-\\d{2}$"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "seed": {
      "type": "integer"
    },
    "essays": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^E-([A-Z]{3}|XO)-\\d{3}$"
      }
    },
    "pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "mbe": {
      "type": "object",
      "required": [
        "am",
        "pm"
      ],
      "additionalProperties": false,
      "properties": {
        "am": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q-[A-Z]{3}-\\d{4}$"
          }
        },
        "pm": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q-[A-Z]{3}-\\d{4}$"
          }
        }
      }
    },
    "complete": {
      "type": "boolean",
      "description": "False if the bank was too small for a full exam"
    },
    "shortfall": {
      "type": "object"
    },
    "taken": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
